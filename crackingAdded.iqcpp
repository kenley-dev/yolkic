{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\ntouchled TouchLED3 = touchled(PORT3);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n\nusing namespace vex;\n\n// ---- config.h ----\n// Initialize the brain, motors, and sensors necessary for toggling the robot on and off\n\nconst double ROBOT_INTERVAL = 0.5; // Time interval for robot operations in seconds\n\ntouchled touchSensor(PORT5);\ntimer robotTimer;\n\n// ---- capsule.h ----\n// Initialize all sensors and motors pertaining to the capsule system\nconst double CAPSULE_INTERVAL = 0.25;\n\ntimer capsuleTimer;\nmotor capsuleTopMotor(PORT1, false);\nmotor capsuleBottomMotor(PORT2, true);\n\n// ---- feeder.h ----\n// Initialize all sensors, timer, and motors pertaining to the feeder system\nconst double FEEDER_INTERVAL = 0.25;\ntimer feederTimer;\nmotor feederMotor(PORT3, true);\noptical feederSensor(PORT4);\n\n// ---- cracker.h ----\nmotor crackerMotor(PORT6, true);\n\n// ---- config.cpp ----\n// Function to calibrate all sensors and motors\nvoid calibrateSensors() {\n    // Implementation for sensor calibration\n    touchSensor.on(blue);\n    BrainInertial.resetRotation();\n}\n\n// Write a function to turn robot on\n/*void turnRobotOn() {\n    // Implementation for turning the robot on\n}\n\n// Write a function to turn robot off\nvoid turnRobotOff() {\n    // Implementation for turning the robot off\n}\n*/\n\n// ---- capsule.cpp ----\nbool checkCapsuleState() {\n\n    feederSensor.setLight(ledState::on);\n    feederTimer.clear();\n    \n    while (feederTimer.time(seconds) < FEEDER_INTERVAL*5) { // checks for 10 seconds if the capsule is empty or not\n        Brain.Screen.clearScreen();\n        Brain.Screen.setCursor(1, 1);\n        \n        if (feederSensor.hue() <= 20 && feederSensor.hue() >= 5) { // checks if the color detected is white (hue value between 5 and 20)\n            Brain.Screen.print(\"Object detected!\");\n            return true; // Egg detected, capsule is not empty\n\n        } else {\n            Brain.Screen.print(\"Not white.\"); // No egg detected\n        }\n\n        wait(20, msec);\n    }\n\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Capsule is empty!\");\n    return false; // No egg detected, capsule is empty\n}\n\nvoid moveTopMotor(float angle){\n  capsuleTopMotor.resetPosition();\n  if (angle < 0){\n    capsuleTopMotor.spin(reverse, 10, percent);\n    while (capsuleTopMotor.position(degrees) > angle){}\n    capsuleTopMotor.stop(brake);\n  } else{\n    capsuleTopMotor.spin(forward, 10, percent);\n    while(capsuleTopMotor.position(degrees) < angle){}\n    capsuleTopMotor.stop(brake);\n  }\n}\n\nvoid moveBottomMotor(float angle){\n  capsuleBottomMotor.resetPosition();\n  if (angle  < 0){\n    capsuleBottomMotor.spin(reverse, 10, percent);\n    while (capsuleBottomMotor.position(degrees) > angle){}\n    capsuleBottomMotor.stop(brake);\n  } else{\n    capsuleBottomMotor.spin(forward, 10, percent);\n    while(capsuleBottomMotor.position(degrees) < angle){}\n    capsuleBottomMotor.stop(brake);\n  }\n}\n\n// Reset capsule motors (reset to base position)\nvoid resetCapsuleMotors() {\n}\n\n// ---- feeder.cpp ----\nvoid closeFeeder() {\n    // Implementation for closing the feeder\n    feederMotor.resetPosition();\n    feederTimer.clear();\n\n    while (feederTimer.time(seconds) <= FEEDER_INTERVAL){} // waits one seconds before starting the feeder motor\n\n    feederMotor.spin(reverse, 25, percent);\n\n    while (feederMotor.position(degrees) >= -90) {}\n\n    feederMotor.stop(brake);\n\n\n}\n\nvoid openFeeder() {\n    // Implementation for opening the feeder\n    feederMotor.resetPosition();\n    feederTimer.clear();\n\n    while (feederTimer.time(seconds) <= FEEDER_INTERVAL) {} // waits one seconds before starting the feeder motor\n    \n    feederMotor.spin(forward, 25, percent);\n\n    while (feederMotor.position(degrees) <= 105) {}\n\n    feederMotor.stop(brake);\n\n}\n\nvoid prepareCapsule() {\n\n    moveTopMotor(-90);\n\n    while (capsuleTimer.time(seconds) <= CAPSULE_INTERVAL*20) {} // waits a quarter of a seconds before starting the cracker motors\n\n    moveBottomMotor(-90);\n    capsuleTimer.clear();\n\n    while (capsuleTimer.time(seconds) <= CAPSULE_INTERVAL) {}\n\n    moveBottomMotor(90);\n    capsuleTimer.clear();\n\n}\n\n// ---- cracker.cpp ----\nvoid crackEgg() {\n    // Implementation for cracking the egg\n    crackerMotor.resetPosition();\n\n    crackerMotor.spin(forward, 100, percent);\n\n    while (crackerMotor.position(degrees) <= 180) {}\n\n    crackerMotor.stop();\n    crackerMotor.spin(reverse, 100, percent);\n\n    while (crackerMotor.position(degrees) >= 0) {}\n\n    crackerMotor.stop();\n\n}\n\n// ---- main.cpp ----\nint main() {\n    vexcodeInit();\n    // Initial calibration\n    calibrateSensors();\n    \n    while (!touchSensor.pressing()) {}\n    while (touchSensor.pressing()) {}\n\n    robotTimer.clear();\n\n    // open feeder and move capsule at the same time\n    moveTopMotor(90);\n    openFeeder();\n    closeFeeder();\n    if (checkCapsuleState()) {\n\n        robotTimer.clear();\n        moveTopMotor(-90);\n\n        while (robotTimer.time(seconds) <= ROBOT_INTERVAL*2) {} // waits a full second before starting the cracker motors\n\n        robotTimer.clear();\n        crackEgg();\n\n        while (robotTimer.time(seconds) <= ROBOT_INTERVAL*4) {}\n\n        moveBottomMotor(90);\n        robotTimer.clear();\n    }\n    \n    Brain.programStop();\n\n}\n","textLanguage":"cpp","robotConfig":[],"slot":2,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}