{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\ntouchled TouchLED3 = touchled(PORT3);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n\nusing namespace vex;\n\n// ---- config.h ----\n// Initialize the brain, motors, and sensors necessary for toggling the robot on and off\n\ntouchled touchSensor(PORT12);\n\n// ---- capsule.h ----\n// Initialize all sensors and motors pertaining to the capsule system\nconst double CAPSULE_INTERVAL = 0.25;\n\ntimer capsuleTimer;\nmotor capsuleTopMotor(PORT6, false);\nmotor capsuleBottomMotor(PORT2, true);\noptical capsuleOptical(PORT4);\n\n// ---- feeder.h ----\n// Initialize all sensors, timer, and motors pertaining to the feeder system\nconst double FEEDER_INTERVAL = 0.25;\ntimer feederTimer;\nmotor feederMotor(PORT1, true);\n\n// ---- cracker.h ----\nmotor crackerMotor(PORT5, false);\n\n// ---- counter.h ----\nconst double COUNTER_INTERVAL = 0.25;\nbumper counterBumper(PORT7);\n\n// ---- config.cpp ----\n// Function to calibrate all sensors and motors\nvoid calibrateSensors() {\n    // Implementation for sensor calibration\n    touchSensor.on(red);\n    BrainInertial.resetRotation();\n}\n\nbool eStopActivated() {\n    if (!touchSensor.pressing()) {\n        while (touchSensor.pressing()) { wait(5, msec); } // wait for release\n\n        Brain.Screen.clearScreen();\n        Brain.Screen.setCursor(1, 1);\n        Brain.Screen.print(\"Emergency Stop Activated!\");\n        return true;\n    }\n\n    return false;\n}\n\n// ---- capsule.cpp ----\nbool checkCapsuleState() {\n\n    capsuleOptical.setLight(ledState::on);\n    capsuleTimer.clear();\n    \n    while (capsuleTimer.time(seconds) < CAPSULE_INTERVAL*5) { // checks for 10 seconds if the capsule is empty or not\n        Brain.Screen.clearScreen();\n        Brain.Screen.setCursor(1, 1);\n        \n        if (capsuleOptical.hue() <= 20 || capsuleOptical.hue() >= 5) { // checks if the color detected is white (hue value between 20 and 340)\n            Brain.Screen.print(\"Object detected!\");\n            return true; // Egg detected, capsule is not empty\n\n        } else {\n            Brain.Screen.print(\"Not white.\"); // No egg detected\n        }\n\n        wait(20, msec);\n    }\n\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Capsule is empty!\");\n    return false; // No egg detected, capsule is empty\n}\n\nvoid moveTopMotor(float angle){\n  capsuleTopMotor.resetPosition();\n  if (angle < 0){\n    capsuleTopMotor.spin(reverse, 5, percent);\n    while (capsuleTopMotor.position(degrees) > angle){}\n    capsuleTopMotor.stop(brake);\n  } else{\n    capsuleTopMotor.spin(forward, 5, percent);\n    while(capsuleTopMotor.position(degrees) < angle){}\n    capsuleTopMotor.stop(brake);\n  }\n}\n\nvoid moveBottomMotor(float angle){\n  capsuleBottomMotor.resetPosition();\n  if (angle  < 0){\n    capsuleBottomMotor.spin(reverse, 5, percent);\n    while (capsuleBottomMotor.position(degrees) > angle){}\n    capsuleBottomMotor.stop(brake);\n  } else{\n    capsuleBottomMotor.spin(forward, 5, percent);\n    while(capsuleBottomMotor.position(degrees) < angle){}\n    capsuleBottomMotor.stop(brake);\n  }\n}\n\nvoid dropEgg() {\n\n    moveBottomMotor(-90);\n    capsuleTimer.clear();\n\n    while (capsuleTimer.time(seconds) <= CAPSULE_INTERVAL) {}\n\n    moveBottomMotor(90);\n    capsuleTimer.clear();\n\n}\n\n// ---- feeder.cpp ----\nvoid closeFeeder() {\n    // Implementation for closing the feeder\n    feederMotor.resetPosition();\n    feederTimer.clear();\n\n    while (feederTimer.time(seconds) <= FEEDER_INTERVAL) {} // waits one seconds before starting the feeder motor\n\n    feederMotor.spin(reverse, 15, percent);\n\n    while (feederMotor.position(degrees) >= -90) {}\n\n    feederMotor.stop(brake);\n\n\n}\n\nvoid openFeeder() {\n    // Implementation for opening the feeder\n    feederMotor.resetPosition();\n    feederTimer.clear();\n\n    while (feederTimer.time(seconds) <= FEEDER_INTERVAL) {} // waits one seconds before starting the feeder motor\n    \n    feederMotor.spin(forward, 25, percent);\n\n    while (feederMotor.position(degrees) <= 100) {}\n\n    feederMotor.stop(brake);\n\n}\n\n// ---- cracker.cpp ----\nvoid crackEggKen() {\n    // Implementation for cracking the egg\n    crackerMotor.resetPosition();\n\n    crackerMotor.spin(forward, 100, percent);\n\n    while (crackerMotor.position(degrees) <= 180) {}\n\n    crackerMotor.stop();\n    crackerMotor.spin(reverse, 15, percent);\n\n    while (crackerMotor.position(degrees) >= 0) {}\n\n    crackerMotor.stop();\n\n}\n\n/*void crackEggSeb(){\n\ncrackerMotor.resetPosition();\ncrackerMotor.spin(forward, 100, degrees);\n\nwhile (crackerMotor.position(degrees) < 200){}\n\ncrackerMotor.stop(brake);\n\nfloat movedDistance = crackerMotor.position(degrees);\nfloat distanceNeeded = 360 - movedDistance;\n\ncrackerMotor.spin(reverse, 25, percent);\n\nwhile (crackerMotor.position(degrees) < distanceNeeded){}\n\ncrackerMotor.stop(brake);\n}\n*/\n\n// ---- counter.cpp ----\n// Function to count the number of eggs (FAULTY, PLEASE REWRITE)\nvoid countEggs(int& eggCount) {\n\n    // Keep counting until the touch LED is pressed\n    while (!touchSensor.pressing()) {\n\n        if (counterBumper.pressing()) {\n            eggCount++;\n\n            while (counterBumper.pressing()) { wait(5, msec); } // wait for release\n            wait(20, msec); // debounce\n\n            Brain.Screen.clearScreen();\n            Brain.Screen.setCursor(1, 1);\n            Brain.Screen.print(\"Eggs counted: %d\", eggCount);\n        }\n\n        wait(5, msec);\n    }\n\n    while (touchSensor.pressing()) { wait(5, msec); } // wait for release\n}\n\n// Function to check if all eggs have been cracked\nbool allEggsCracked(int eggCount) {\n\n    // Logic to determine if all eggs have been cracked\n    if (eggCount == 0) {\n        return true;\n    } else {\n        return false;\n    }\n}\n\n// ---- main.cpp ----\nint main() {\n    vexcodeInit();\n    \n    while (!Brain.buttonCheck.pressing()) { wait(5, msec); } // Waitting for the user to press the button to start the program\n    while (Brain.buttonCheck.pressing()) { wait(5, msec); }\n\n    // Initial calibration\n    int eggCount = 0;\n    calibrateSensors();\n   \n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Load all eggs into the capsule and press the button to start cracking!\");\n    \n    countEggs(eggCount);\n\n    while (!touchSensor.pressing()) { wait(5, msec);} // Wait for the touch sensor to be released before starting the main loop\n    while (touchSensor.pressing()) { wait(5, msec);}\n\n    touchSensor.on(green);\n\n    while (!eStopActivated() && !allEggsCracked(eggCount)) { // Main loop continues until emergency stop is activated or all eggs are cracked\n\n        // open feeder and move capsule at the same time\n        moveTopMotor(90);\n        openFeeder();\n        closeFeeder();\n\n        if (checkCapsuleState()) {\n            moveTopMotor(-90);\n            crackEggKen();\n            eggCount -= 1;\n            dropEgg();\n        }\n\n    }\n\n    touchSensor.off();\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Program stopped.\");\n    Brain.programStop();\n\n}\n","textLanguage":"cpp","robotConfig":[{"port":[3],"name":"TouchLED3","customName":false,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22}],"slot":1,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}