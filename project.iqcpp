{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\ntouchled TouchLED3 = touchled(PORT3);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n\nusing namespace vex;\n\n// ---- config.h ----\n// Initialize the brain, motors, and sensors necessary for toggling the robot on and off // Time interval for robot operations in seconds\n\ntouchled touchSensor(PORT12);\n\n// ---- capsule.h ----\n// Initialize all sensors and motors pertaining to the capsule system\nconst double CAPSULE_INTERVAL = 0.25;\n\ntimer capsuleTimer;\nmotor capsuleTopMotor(PORT6, false);\nmotor capsuleBottomMotor(PORT2, true);\noptical capsuleOptical(PORT4);\n\n// ---- feeder.h ----\n// Initialize all sensors, timer, and motors pertaining to the feeder system\nconst double FEEDER_INTERVAL = 0.25;\ntimer feederTimer;\nmotor feederMotor(PORT1, true);\n\n// ---- cracker.h ----\nmotor crackerMotor(PORT5, false);\n\n// ---- counter.h ----\nbumper counterBumper(PORT7);\n\n// ---- config.cpp ----\n// Function to calibrate all sensors needed for start-up or shut-down\nvoid calibrateSensors() {\n    touchSensor.on(red);\n    BrainInertial.resetRotation();\n}\n\n// Function to shut-dwon all motors and sensors\nvoid stopAllMotors() {\n    touchSensor.off();\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Motors stopped.\");\n    capsuleTopMotor.stop(brake);\n    capsuleBottomMotor.stop(brake);\n    feederMotor.stop(brake);\n    crackerMotor.stop(brake);\n}\n\n// Boolean function used to check if the e-stop button has been pressed to initate a shut-down procedure\nbool eStopActivated() {\n\n    if (touchSensor.pressing()) {\n        stopAllMotors();\n        touchSensor.on(red);\n        Brain.Screen.clearScreen();\n        Brain.Screen.setCursor(1, 1);\n        Brain.Screen.print(\"Emergency Stop Activated!\");\n        Brain.programStop();\n        return true;\n    }\n\n    return false;\n}\n\n// ---- capsule.cpp ----\nbool checkCapsuleState() {\n\n    capsuleOptical.setLight(ledState::on); // ensures we can detect white\n    capsuleTimer.clear();\n    \n    while (capsuleTimer.time(seconds) < CAPSULE_INTERVAL*8) { // checks for 2 seconds if the capsule is empty or not\n        Brain.Screen.clearScreen();\n        Brain.Screen.setCursor(1, 1);\n        \n        wait(1, seconds);\n\n        // Checks for a white egg with a hue range of 10 to 30\n        if (capsuleOptical.hue() >= 10 && capsuleOptical.hue() <= 30) { \n            Brain.Screen.print(\"Object detected!\");\n            return true;\n\n        } else {\n            Brain.Screen.print(\"Not a white egg\");\n        }\n\n        wait(20, msec);\n    }\n\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Capsule is empty!\");\n    return false;\n}\n\n// Versitile function that takes an angle as a parameter and moves the top capsule motor accordingly\nvoid moveTopCapsuleMotor(float angle) {\n  capsuleTopMotor.resetPosition();\n\n  if (angle < 0) {\n\n    capsuleTopMotor.spin(reverse, 5, percent);\n\n    while (capsuleTopMotor.position(degrees) > angle){eStopActivated();}\n\n    capsuleTopMotor.stop(brake);\n\n  } else {\n\n    capsuleTopMotor.spin(forward, 5, percent);\n\n    while(capsuleTopMotor.position(degrees) < angle){eStopActivated();}\n\n    capsuleTopMotor.stop(brake);\n\n  }\n}\n\n// Versitile function that takes an angle as a parameter and moves the top capsule motor accordingly\nvoid moveBottomCapsuleMotor(float angle) {\n  capsuleBottomMotor.resetPosition();\n\n  if (angle  < 0) {\n\n    capsuleBottomMotor.spin(reverse, 5, percent);\n\n    while (capsuleBottomMotor.position(degrees) > angle){eStopActivated();}\n\n    capsuleBottomMotor.stop(brake);\n\n  } else {\n\n    capsuleBottomMotor.spin(forward, 5, percent);\n\n    while(capsuleBottomMotor.position(degrees) < angle){eStopActivated();}\n\n    capsuleBottomMotor.stop(brake);\n\n  }\n}\n\n// Function that uses the previous helper functions to automate the egg-empting process\nvoid emptyContents() {\n\n    moveBottomCapsuleMotor(-90);\n    capsuleTimer.clear();\n\n    while (capsuleTimer.time(seconds) <= CAPSULE_INTERVAL) {eStopActivated();}\n\n    moveBottomCapsuleMotor(90);\n    capsuleTimer.clear();\n\n}\n\n// ---- feeder.cpp ----\n// A function to close the feeder\nvoid closeFeeder() {\n\n    feederMotor.resetPosition();\n    feederTimer.clear();\n\n    // quarter of a second time interval for estop to be registered\n    while (feederTimer.time(seconds) <= FEEDER_INTERVAL){eStopActivated();} \n\n    feederMotor.spin(reverse, 15, percent);\n\n    while (feederMotor.position(degrees) >= -70) {eStopActivated();}\n\n    feederMotor.stop(hold);\n\n}\n\n// A function to open the feeder 80 degrees\nvoid openFeeder() {\n\n    feederMotor.resetPosition();\n    feederTimer.clear();\n\n    while (feederTimer.time(seconds) <= FEEDER_INTERVAL) {eStopActivated();}\n\n    feederMotor.spin(forward, 50, percent);\n\n    while(feederMotor.position(degrees) <= 80) {eStopActivated();}\n\n    feederMotor.stop(hold);\n\n}\n\n// A function to jitter the feeder platform so as to release only one egg\nvoid jitterFeeder() {\n\n    feederMotor.spin(forward, 10, percent);\n\n    while(feederMotor.position(degrees) <= 90) {eStopActivated();};\n\n    feederMotor.stop(hold);\n\n    wait(0.1, seconds);\n\n    feederMotor.spin(reverse, 30, percent);\n\n    while(feederMotor.position(degrees) >= 70) {eStopActivated();}\n\n    feederMotor.stop(hold);\n\n}\n\n// A function that automates the release of a singular egg\nvoid releaseEgg() {\n\n  openFeeder();\n\n  wait(1, seconds);\n\n  jitterFeeder();\n\n  closeFeeder();\n\n}\n\n// ---- cracker.cpp ----\n// A function that automates teh egg-cracking process\nvoid crackEgg() {\n\n    crackerMotor.resetPosition();\n\n    crackerMotor.spin(forward, 100, percent);\n\n    while (crackerMotor.position(degrees) <= 180) {eStopActivated();}\n\n    crackerMotor.stop();\n    crackerMotor.spin(reverse, 15, percent);\n\n    while (crackerMotor.position(degrees) >= 0) {eStopActivated();}\n\n    crackerMotor.stop();\n\n}\n\n// ---- counter.cpp ----\n// Versitle function that takes a variable as a reference and tracks the number of eggs placed into the feeder\nvoid countEggs(int& eggCount) {\n\n    while (!touchSensor.pressing()) {\n        \n        if (counterBumper.pressing()) {\n            eggCount++;\n\n            while (counterBumper.pressing()) { wait(10, msec); }\n\n            Brain.Screen.clearScreen();\n            Brain.Screen.setCursor(1, 1);\n            Brain.Screen.print(\"Eggs counted: %d\", eggCount);\n        }\n        \n        wait(10, msec);\n    }\n    \n    while (touchSensor.pressing()) { wait(10, msec); }   // wait for release\n\n}\n\n// Boolean function that checks if all the eggs have been cracked, used as a terminating condition\nbool allEggsCracked(int eggCount) {\n\n    if (eggCount == 0) {\n        return true;\n    } else {\n        return false;\n    }\n\n}\n\n// ---- main.cpp ----\nint main() {\n    vexcodeInit();\n    \n    // Waitting for the user to click the brain check button before starting the program\n    while (!Brain.buttonCheck.pressing()) {}\n    while (Brain.buttonCheck.pressing()) {}\n\n    // Initial calibration of sensors and an egg coutning variable\n    int eggCount = 0;\n    calibrateSensors();\n    \n    // Prompts the user to start loading eggs and to tap the touch led to start the cracking process\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Load all eggs into the capsule and press\");\n    Brain.Screen.setCursor(2,1);\n    Brain.Screen.print(\"the Touch LED to start cracking!\");\n    \n    // Tracks the number of eggs placed into the feeder, the program will not proceed\n    // further until the user has finsihed loading eggs and tapped the touch led\n    countEggs(eggCount);\n\n    // Informs the user that they have finished loading their eggs and that the cracking will begin\n    touchSensor.on(green);\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Program started. Cracking eggs...\");\n\n    // Informs user that the touch led can be tapped to stop teh prgram at any time\n    Brain.Screen.setCursor(2, 1);\n    Brain.Screen.print(\"Tap the touch LED for an e-stop.\");\n\n    // Main loop continues until all eggs are cracked\n    while (!allEggsCracked(eggCount)) {\n        \n        // opens the egg capsule\n        moveTopCapsuleMotor(75);\n\n        // releases one egg from the feeder\n        releaseEgg();\n\n        // using the optical sensor, checks if an egg has been properly placed in the capsule\n        if (checkCapsuleState()) {\n            // if it has, the capsule closes to securly hold the egg in place\n            moveTopCapsuleMotor(-75);\n\n            // the egg is cracked\n            crackEgg();\n\n            // the egg count decrease by one, and the status of eggs left is printed for the user convience\n            eggCount -= 1;\n            Brain.Screen.clearScreen();\n            Brain.Screen.setCursor(1, 1);\n            Brain.Screen.print(\"Eggs left: %d\", eggCount);\n\n            // lastly, the contents of the egg are emptied through a filter and into a bowl\n            emptyContents();\n\n        } else {\n            // otherwise, reset the position of the capsule to prepare for the next egg\n            moveTopCapsuleMotor(-75);\n\n            // even in failure, the egg count decrease by one, and the status of eggs left is printed\n            Brain.Screen.clearScreen();\n            Brain.Screen.setCursor(1, 1);\n            Brain.Screen.print(\"Eggs left: %d\", eggCount);\n        }\n\n    }\n\n    // once all eggs have been cracked, all motors will stop and the program will be terminated\n    stopAllMotors();\n    Brain.programStop();\n\n}\n","textLanguage":"cpp","robotConfig":[{"port":[3],"name":"TouchLED3","customName":false,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}